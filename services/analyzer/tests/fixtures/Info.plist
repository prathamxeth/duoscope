<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.example.auditedapp</string>
    <key>CFBundleName</key>
    <string>AuditedApp</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <!-- Anti-pattern: Only UIDeviceFamily 1 (iPhone), missing 2 (iPad/Expanded dual-screen) -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
    </array>
    <!-- Anti-pattern: UIRequiresFullScreen true blocks foldable multi-window split & fluid continuity -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
